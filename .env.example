# Скопируй в .env и подставь значения. Файл .env в .gitignore — секреты не коммитятся.
# Переменные, уже заданные в окружении (systemd и т.п.), имеют приоритет над .env.
# В Docker (docker compose up -d) файл необязателен: адреса БД и Redis задаёт compose,
# остальное — значения по умолчанию. См. docs/docker.md.

# --- Docker (всё необязательно) ---
# SITE_ADDRESS=localhost                  # домен (Let's Encrypt) или IP/localhost (внутренний CA Caddy)
# POSTGRES_PROCESSED_PASSWORD=            # пароли БД — задать ДО первого запуска
# POSTGRES_RAW_PASSWORD=
# WORKER_REPLICAS=2                       # контейнеров worker
# HTTP_PORT=80  HTTPS_PORT=443            # порты на хосте

# --- Онлайн-модель DeepSeek (обязательно) ---
DEEPSEEK_API_KEY=sk-ваш_ключ
# DEEPSEEK_MODEL=deepseek-chat            # модель по умолчанию для генерации/разметки
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=300                    # таймаут запроса, сек
# DEEPSEEK_MAX_RETRIES=3                  # повторов при сетевом сбое/таймауте
# Переопределение модели по ролям (по умолчанию все = DEEPSEEK_MODEL):
# DEEPSEEK_BIG_MODEL=  DEEPSEEK_SMALL_MODEL=  DEEPSEEK_DOCPIPE_MODEL=
# DEEPSEEK_CLASSIFY_MODEL=  DEEPSEEK_STAFFING_MODEL=

# --- Эмбеддинги/Qdrant удалены ---
# Классификацию документов, поиск ответа и генерацию делает DeepSeek через docpipe
# (LLM-метки этапов/подэтапов в Postgres). Векторного стора и провайдера эмбеддингов нет.

# --- S3-хранилище оригиналов документов (Timeweb). Пусто -> файлы только локально. ---
NEIROMASTER_S3_ENDPOINT=https://s3.twcstorage.ru
NEIROMASTER_S3_BUCKET=neuromaster
NEIROMASTER_S3_REGION=ru-1
NEIROMASTER_S3_KEY=
NEIROMASTER_S3_SECRET=
# NEIROMASTER_S3_PREFIX=documents/

# --- PostgreSQL (по умолчанию локальный) ---
# NEIROMASTER_DB_DSN=postgresql://neiromaster:neiromaster@localhost:5432/neiromaster
# Отдельная БД исходников (оригиналы документов, загруженные штатки). Пусто — исходники
# только в data/documents/ (и S3). Уже загруженное перенести: python rawdb.py --backfill
# NEIROMASTER_RAW_DB_DSN=postgresql://neiromaster_raw:neiromaster_raw@localhost:5433/neiromaster_raw
NEIROMASTER_DB_POOL=15                     # размер пула соединений НА ПРОЦЕСС.
#   Суммарно к БД: (web-воркеры + worker-процессы) * NEIROMASTER_DB_POOL — держи это
#   ниже max_connections Postgres. install.sh поднимает max_connections=300
#   (6 web*15 + 4 worker*15 = 150 < 300). Дальше упрёшься — PgBouncer.

# --- Высокая нагрузка: Redis (очередь задач + общий стейт) ---
# Пусто -> одно-процессный режим (in-memory очереди, как раньше). Задай для масштаба.
REDIS_URL=redis://localhost:6379/0
# DEEPSEEK_MAX_CONCURRENCY=24              # кап ОДНОВРЕМЕННЫХ вызовов DeepSeek на весь
#   кластер — главная защита от шторма 503 под нагрузкой. Крути под лимиты своего тарифа.
WEB_CONCURRENCY=6                         # uvicorn-воркеров в web-тире (gunicorn читает сам)
# NEIROMASTER_RQ_WORKERS=4                 # worker-процессов (rag-worker@1..N)
# NEIROMASTER_DOCPIPE_WORKERS=6            # потоков разметки блоков ВНУТРИ одной задачи
# NEIROMASTER_GEN_WORKERS=6                # потоков генерации подэтапов ВНУТРИ одной задачи

# --- Безопасность ---
# Ключ шифрования ПДн в БД создаётся САМ при первом старте: data/secrets/pii.key (права 600).
#   Сохраните копию файла отдельно от бэкапов БД: потеря ключа = потеря зашифрованных ФИО/контактов.
# NEIROMASTER_PII_KEY=             # свой ключ Fernet вместо файла (несколько серверов — один ключ всем)
# NEIROMASTER_PII_KEY_FILE=        # другое место файла ключа (по умолчанию data/secrets/pii.key)
# NEIROMASTER_PII_MASK=1           # обезличивание ПДн перед отправкой в DeepSeek (0 — выключить, не на проде)
# NEIROMASTER_INSECURE_COOKIE=     # 1 — кука сессии без Secure (ТОЛЬКО локальная разработка без HTTPS)
# NEIROMASTER_ALLOW_REGISTRATION=1 # 0 — выключить самостоятельную регистрацию (доступы выдаёт только админ)
# NEIROMASTER_LOGIN_RATE=120       # попыток входа в минуту с одного IP (вся смена за NAT — один IP)
# NEIROMASTER_ASK_RATE=20          # вопросов ассистенту в минуту от одного пользователя
# NEIROMASTER_TRUSTED_ORIGINS=     # доп. origin'ы для изменяющих запросов с кукой (через запятую)
# NEIROMASTER_CORS_ORIGINS=        # origin'ы веб-сборки мобильного приложения (через запятую)

# --- Прочее ---
# NEIROMASTER_ADMIN_PASSWORD=      # пароль владельца при первом старте, от 8 символов (иначе сгенерится)
# NEIROMASTER_HOST=127.0.0.1       # адрес/порт для python app.py (прод — gunicorn из install.sh)
# NEIROMASTER_PORT=8000
# NEIROMASTER_SCHEDULER=1          # 0 — не запускать доставку в web (гонять dispatch_messages.py по cron)
